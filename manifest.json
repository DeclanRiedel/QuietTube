{
  "manifest_version": 2,
  "name": "Unhook Playables",
  "version": "0.1.0",
  "description": "Hide distracting YouTube sections, including Playables.",
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unhook-playables@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "*://www.youtube.com/*", "*://m.youtube.com/*"],
  "browser_action": {
    "default_title": "Unhook Playables",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
